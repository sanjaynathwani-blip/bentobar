<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Three items go online, and only after the user set them up on this device: Weather asks Open-Meteo,
         while Flight asks AirLabs and US stocks asks Finnhub, the last two with the user's own key. net/Http.kt
         names the four hosts and is the only code that opens a connection; nothing the accessibility service or
         any other item reads goes there. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep awake while BentoBar's bar is hidden: the bar's own window holds the screen otherwise. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Weather's My location, asked for only when an item chooses it: approximate only, never precise, and no background-location permission: Android gives the bar's accessibility service the location under the "while using the app" grant (how Play reads that is decided with the 1.4 submission). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- To explain why the bar can't run when Advanced Protection is on (normal permission). -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- Optional "Usage access", off until the user turns it on in Android settings: per-app data
         use and storage for the Network and Storage menus. BentoBar reads nothing else with it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The app picker for app shortcuts and folders lists launchable apps only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The home screen app (it has no launcher icon): the app menu bar shows nothing while it is in front. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The Googlebook's Feedback app, for the Shortcut item's Report a bug: offered only where it is. -->
        <package android:name="com.google.android.desktop.feedback" />
    </queries>

    <!-- Google Play offers BentoBar only to devices that say they are a PC: Googlebooks and other
         desktop-class Android devices (BentoBar adds items to the desktop's status bar). Android itself
         doesn't check this, so the APK from GitHub still installs anywhere. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="true" />

    <!-- Backups carry the layout, as before. What belongs to one install (whether an online service is
         switched on, the user's key, what a service last sent) is kept in Android's no-backup directory,
         and the rules say so once more. No connection is ever made in clear text. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BentoBar"
        android:usesCleartextTraffic="false">

        <!-- Lets the shell (adb) profile release builds with simpleperf; no effect for users. -->
        <profileable android:shell="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- "BentoBar menu": opens the bar's menu with every item, for the keyboard. A launcher entry so
             it can be given a shortcut in the system's keyboard shortcut settings (Action + / › Customize);
             BentoBar itself never reads keys. -->
        <activity
            android:name=".ui.BarMenuActivity"
            android:exported="true"
            android:label="@string/barmenu_shortcut_label"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/Theme.BentoBar.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".bar.BarService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- BentoBar's entry in Android's "Notification access" list, for Now playing: Android tells an app
             what the media players are playing only if the user turned the app on there. BentoBar wants the
             players' titles and no notifications, and says so three times over: it asks for no notification
             type (an empty default list means none), it marks all four types as never wanted (15 is
             conversations, alerting, silent and ongoing together; Android's page for the listener then shows
             them off and disabled), and Android is not to start this service by itself. Off until the user
             turns it on; Now playing works without it, with an icon and the media keys. items/MediaAccess.kt. -->
        <service
            android:name=".items.MediaAccess"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types" android:value="" />
            <meta-data android:name="android.service.notification.disabled_filter_types" android:value="15" />
            <meta-data android:name="android.service.notification.default_autobind_listenerservice" android:value="false" />
        </service>

        <service
            android:name=".tile.BarTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_bar"
            android:label="@string/tile_bar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".tile.AwakeTile"
            android:exported="true"
            android:icon="@drawable/sym_coffee"
            android:label="@string/tile_awake"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".tile.TimerTile"
            android:exported="true"
            android:icon="@drawable/sym_timer"
            android:label="@string/tile_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".items.TimerAlarm" android:exported="false" />
        <receiver android:name=".items.ChipAction" android:exported="false" />

    </application>
</manifest>
